# Flask 配置
FLASK_ENV=development
FLASK_DEBUG=True
SECRET_KEY=your-secret-key-here
# 可选：为空时不启用登录保护
ACCESS_CODE=your-access-code-here

# 服务器配置
HOST=0.0.0.0
PORT=5090

# 日志配置
LOG_LEVEL=INFO
LOG_FILE=logs/meetingez.log

# 安全配置
MAX_CONTENT_LENGTH=16777216  # 16MB

# ============================================================
# Meeting Agent 配置（会议纪要整理 Agent）
# ============================================================

# OpenRouter ASR（首选：Google Chirp 3）
OPENROUTER_API_KEY=your_openrouter_api_key_here
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1  # 可选
# OPENROUTER_ASR_MODEL=google/chirp-3              # 可选
# OPENROUTER_ASR_LANGUAGE=                         # 可选，留空使用自动语言检测；如需指定可填 zh/en
# OPENROUTER_ASR_TIMEOUT=120                       # 可选，秒
# OPENROUTER_SITE_URL=                             # 可选，用于 OpenRouter 排名/归因
# OPENROUTER_SITE_NAME=MeetingEZ                   # 可选

# 智谱 AI ASR（OpenRouter 不可用时降级）
ZHIPU_API_KEY=your_zhipu_api_key_here
# ZHIPU_ASR_MODEL=glm-asr-2512  # 可选，智谱 ASR 模型名

# OpenAI GPT-5.4（纪要生成与项目记忆）
OPENAI_API_KEY=your_openai_api_key_here
# OPENAI_BASE_URL=https://api.openai.com/v1  # 可选，用于代理
# OPENAI_MODEL=gpt-5.4  # 可选，纪要生成模型名
# Web 端实时转写模型
# TRANSCRIPTION_MODEL=gpt-realtime-whisper  # 可选
# gpt-realtime-whisper 延迟/准确率档位：minimal/low/medium/high/xhigh
# 值越低首个 delta 越快、准确率略降；默认 low
# TRANSCRIPTION_DELAY=low  # 可选
# Web 端实时翻译（Realtime Translation，唯一翻译路径）
# REALTIME_TRANSLATION_MODEL=gpt-realtime-translate  # 可选
# REALTIME_TRANSLATION_INPUT_MODEL=gpt-realtime-whisper  # 可选

# 项目目录配置
# 单项目模式：直接指定会议目录
MEETINGS_DIR=./meetings
# 多项目模式：指定项目根目录（二选一）
# PROJECTS_DIR=./projects

# Agent 行为配置
RECENT_MINUTES_COUNT=5            # 参考最近 N 份纪要
DEFAULT_LANGUAGE=zh-CN            # 默认语言
TIMEZONE=Asia/Shanghai            # 时区

# ASR 配置
ASR_CHUNK_SECONDS=30              # ASR 分块时长（秒）
ASR_OVERLAP_SECONDS=2             # ASR 重叠时长（秒）
