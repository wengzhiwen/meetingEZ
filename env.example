# Flask 配置
FLASK_ENV=development
FLASK_DEBUG=True
SECRET_KEY=your-secret-key-here
# 可选：为空时不启用登录保护
ACCESS_CODE=your-access-code-here

# 服务器配置
HOST=0.0.0.0
PORT=5090

# 日志配置
LOG_LEVEL=INFO
LOG_FILE=logs/meetingez.log

# 安全配置
MAX_CONTENT_LENGTH=16777216  # 16MB

# ============================================================
# Meeting Agent 配置（会议纪要整理 Agent）
# ============================================================

# OpenAI 是全系统唯一的模型供应商：实时转写、实时翻译、离线转写、纪要生成
OPENAI_API_KEY=your_openai_api_key_here
# OPENAI_BASE_URL=https://api.openai.com/v1  # 可选，用于代理
# OPENAI_MODEL=gpt-5.6-sol  # 可选，纪要生成模型名
# OPENAI_REASONING_EFFORT=high  # 可选，纪要推理档位 none/low/medium/high/xhigh/max

# 离线文件转写（CLI Agent）：gpt-transcribe，/v1/audio/transcriptions
# OPENAI_ASR_MODEL=gpt-transcribe  # 可选
# 预期输入语言，逗号分隔 ISO-639-1 短码；留空由模型自动检测
# OPENAI_ASR_LANGUAGES=zh,en  # 可选
# OPENAI_ASR_TIMEOUT=300  # 可选，秒

# Web 端实时转写模型（Realtime transcription session）
# TRANSCRIPTION_MODEL=gpt-live-transcribe  # 可选
# 延迟/准确率档位：minimal/low/medium/high/xhigh
# 值越低首个 delta 越快、准确率略降；默认 low
# TRANSCRIPTION_DELAY=low  # 可选

# 本地 ASR（Qwen3-ASR）实时转写服务地址。浏览器从实时会议页直连该地址，
# 不经后端中转。该值仅作为前端「转写引擎」里端点输入框的默认值，
# 用户可在设置面板中修改并持久化（localStorage 优先于本默认值）。
# 例：LOCAL_ASR_BASE_URL=http://192.168.1.10:8000
# LOCAL_ASR_BASE_URL=http://127.0.0.1:8000  # 可选

# 本地翻译（可选）：在实时页设置面板配置 OpenAI 兼容 API 端点 + 模型名，
# 浏览器直连 {端点}/chat/completions 做逐段后置翻译（纯前端行为，无后端配置）。
# 端点需开启 CORS，如 vLLM 启动加：--allowed-origins '["*"]'

# Web 端实时翻译（Realtime Translation，唯一翻译路径）
# REALTIME_TRANSLATION_MODEL=gpt-realtime-translate  # 可选
# REALTIME_TRANSLATION_INPUT_MODEL=gpt-live-transcribe  # 可选

# 术语校正后置处理：realtime session 注入不了术语表，定格后的字幕交给便宜的文本模型
# 按术语表纠错，返回后原位替换。默认 effort=high；延迟敏感可降 low（实测约 4 秒 / 6 句）
# REFINE_MODEL=gpt-5.6-luna  # 可选
# REFINE_REASONING_EFFORT=high  # 可选，默认 high；low/none 更快但会漏音译类错误

# 项目目录配置
# 单项目模式：直接指定会议目录
MEETINGS_DIR=./meetings
# 多项目模式：指定项目根目录（二选一）
# PROJECTS_DIR=./projects

# Agent 行为配置
RECENT_MINUTES_COUNT=5            # 参考最近 N 份纪要
DEFAULT_LANGUAGE=zh-CN            # 默认语言
TIMEZONE=Asia/Shanghai            # 时区

# 离线 ASR 分块配置
# gpt-transcribe 不返回时间戳，分块边界就是时间戳精度来源（块内再按字符数摊到句子）。
# 分块不重叠：没有时间戳无法对重叠文本去重，改用上一块结尾文本作为下一块的 prompt。
ASR_CHUNK_SECONDS=120             # ASR 分块时长（秒），越小时间戳越细、请求越多
ASR_CONTEXT_CHARS=400             # 传给下一块 prompt 的上文长度（字符）
ASR_KEYWORDS_LIMIT=100            # 单次请求下发的 keywords 上限
